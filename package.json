{
    "name": "sky-to-porch-webmcp",
    "version": "0.1.0",
    "private": true,
    "license": "Apache-2.0",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "secret-check": "node scripts/secret-check.mjs",
        "release:preflight": "node scripts/public-release-preflight.mjs",
        "test:contracts": "vitest run --config vitest.config.ts --reporter verbose src/__tests__/unit/contracts.test.ts",
        "test:fixtures": "vitest run --config vitest.integration.config.ts --reporter verbose src/__tests__/integration/wp02-fixtures.test.ts",
        "smoke:wp02:live": "node scripts/wp02-live-source-smoke.mjs",
        "smoke:wp05:live": "node scripts/wp05-live-source-smoke.mjs",
        "smoke:wp08:live": "node scripts/wp08-live-source-smoke.mjs",
        "smoke:wp09:live": "node scripts/wp09-live-source-smoke.mjs",
        "smoke:wp10:custom-area:live": "vite-node --config vitest.config.ts scripts/wp10-custom-area-live-source-smoke.ts",
        "smoke:wp10:prepared:live": "vite-node --config vitest.config.ts scripts/wp10-prepared-live-source-smoke.ts",
        "smoke:wp11:airnow:live": "vite-node --config vitest.config.ts scripts/wp11-airnow-daily-live-source-smoke.ts",
        "smoke:wp12:earth-volcano:live": "vite-node --config vitest.config.ts scripts/wp12-earth-volcano-live-source-smoke.ts",
        "smoke:ghcnh:live": "vite-node --config vitest.config.ts scripts/ghcnh-live-source-smoke.ts",
        "verify": "npm run typecheck && npm run lint && npm run test && npm run test:integration && npm run build && npm run test:e2e && npm run secret-check"
    },
    "dependencies": {
        "@vercel/analytics": "^1.6.1",
        "fast-xml-parser": "5.10.1",
        "maplibre-gl": "5.24.0",
        "next": "15.5.22",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "sharp": "0.35.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.53.0",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.5.0",
        "@vitest/coverage-v8": "^3.2.7",
        "autoprefixer": "^10.4.21",
        "eslint": "^9.0.0",
        "eslint-config-next": "15.5.22",
        "jsdom": "^29.1.1",
        "postcss": "8.5.25",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4",
        "webmcp-types": "^0.1.5"
    },
    "overrides": {
        "nanoid": "3.3.18",
        "postcss": "8.5.25",
        "sharp": "0.35.3"
    }
}
